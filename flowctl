#!/usr/bin/env python3
"""flowd control client.

Deliberately stdlib-only, importing nothing from the flowd package: it runs on
every hotkey press and must finish in under 50 ms (spec 5.9). Importing flowd
would load numpy and the ONNX runtime and blow that budget by an order of
magnitude, so the few lines of socket code below, and `socket_path`, are
duplicated from `flowd.control` and `flowd.config` on purpose.

`tests/test_flowctl.py` imports both this file and `flowd.config` and asserts
the two path computations agree, which is what keeps the copy honest.

`flowctl settings` asks the daemon for a fresh sign-in link to the settings
page and opens it with `xdg-open`, or prints it when there is no `xdg-open`.
"""

from __future__ import annotations

import html
import json
import os
import socket
import subprocess
import sys
import tempfile

APP = "flowd"
SOCKET_NAME = "flowd.sock"
COMMANDS = (
    "start",
    "stop",
    "toggle",
    "cancel",
    "status",
    "last",
    "stats",
    "reload",
    "settings",
)
USAGE = f"usage: flowctl {{{'|'.join(COMMANDS)}}} [--rewrite]"
#: How long to wait for the daemon's reply. A `stop` answers only after STT
#: finalize (up to ~850 ms), the cleanup pass (capped at `final_timeout_ms`,
#: 800 ms) and injection; the earlier 2 s left no margin once the LLM joined, and
#: a timeout here reports an error for a dictation that actually succeeded.
REPLY_TIMEOUT_S = 5.0
#: How long `flowctl settings` waits to see whether `xdg-open` failed.
XDG_OPEN_WAIT_S = 2.0
#: The private page `flowctl settings` hands to the browser. See `write_launcher`.
LAUNCHER_NAME = "settings-open.html"


def socket_path() -> str:
    """Where the daemon listens. Mirrors `flowd.config.runtime_dir`.

    The two branches differ in one way that matters: `$XDG_RUNTIME_DIR` is
    shared between applications, so the socket goes in a `flowd/` subdirectory,
    while the `/tmp` fallback is already per-application and per-user and takes
    the socket directly. Appending the app name in both branches would dial
    `/tmp/flowd-<uid>/flowd/flowd.sock` while the daemon listens one level up.
    """
    override = os.environ.get("FLOWD_SOCKET")
    if override:
        return override
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return os.path.join(runtime, APP, SOCKET_NAME)
    # XDG_RUNTIME_DIR is absent under some systemd units; degrade to /tmp.
    return os.path.join(f"/tmp/{APP}-{os.getuid()}", SOCKET_NAME)


def main(argv: list[str]) -> int:
    args = argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    if not args:
        # Usage errors go to stderr: stdout is what callers pipe as data.
        print(USAGE, file=sys.stderr)
        return 2
    cmd = args[0]
    if cmd not in COMMANDS:
        print(f"flowctl: unknown command {cmd!r}\n{USAGE}", file=sys.stderr)
        return 2

    request: dict[str, object] = {"cmd": cmd}
    if "--rewrite" in args[1:]:
        request["rewrite"] = True

    path = socket_path()
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(REPLY_TIMEOUT_S)
            sock.connect(path)
            sock.sendall(json.dumps(request).encode("utf-8") + b"\n")
            chunks: list[bytes] = []
            while not (chunks and chunks[-1].endswith(b"\n")):
                data = sock.recv(65536)
                if not data:
                    break
                chunks.append(data)
    except (FileNotFoundError, ConnectionRefusedError):
        print(f"flowctl: flowd is not running (no socket at {path})", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"flowctl: {exc}", file=sys.stderr)
        return 1

    try:
        reply = json.loads(b"".join(chunks).decode("utf-8"))
    except (json.JSONDecodeError, UnicodeDecodeError):
        print("flowctl: malformed reply from daemon", file=sys.stderr)
        return 1
    if not isinstance(reply, dict):
        print("flowctl: malformed reply from daemon (expected an object)", file=sys.stderr)
        return 1

    if cmd == "settings" and reply.get("ok") and isinstance(reply.get("url"), str):
        return open_settings(reply["url"])
    # `last` and `stats` are meant for piping, so print their payload bare.
    if cmd == "last" and "text" in reply:
        print(reply["text"])
    elif cmd == "stats" and "stats" in reply:
        print(json.dumps(reply["stats"], indent=2))
    else:
        print(json.dumps(reply))
    return 0 if reply.get("ok", False) else 1


def write_launcher(url: str) -> str:
    """Write a page that forwards the browser to `url`, readable only by us.

    A URL passed to `xdg-open` lands on the browser's command line, which any
    local user can read in /proc. The launcher keeps the token in a mode-0600
    file in our private runtime directory instead: only its path is on the
    command line, and the fragment it forwards to never leaves this browser.
    """
    directory = os.path.dirname(socket_path())
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".settings-", suffix=".html")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            href = html.escape(url, quote=True)
            f.write(
                "<!doctype html><meta charset=utf-8>"
                f'<meta http-equiv="refresh" content="0;url={href}">'
                f'<title>flowd settings</title><a href="{href}">Open flowd settings</a>\n'
            )
        path = os.path.join(directory, LAUNCHER_NAME)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return path


def open_settings(url: str) -> int:
    """Open the settings page in the user's browser.

    The URL carries the user's own sign-in token, so it is printed only when
    the page cannot be opened: they need it to open the page by hand. The
    browser is given a private launcher file, never the URL (see
    `write_launcher`). `xdg-open` runs detached, so a browser it starts
    outlives us. It usually exits as soon as it has handed the file over; one
    still running after `XDG_OPEN_WAIT_S` is taken to be showing the page.
    """
    try:
        launcher = write_launcher(url)
    except OSError as exc:
        return _print_settings_url(url, f"could not write the launcher page ({exc})")
    try:
        proc = subprocess.Popen(
            ["xdg-open", launcher],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        reason = "xdg-open is not installed" if isinstance(exc, FileNotFoundError) else exc
        return _print_settings_url(url, f"could not run xdg-open ({reason})")
    try:
        code = proc.wait(timeout=XDG_OPEN_WAIT_S)
    except subprocess.TimeoutExpired:
        code = 0
    if code != 0:
        return _print_settings_url(url, f"xdg-open failed (exit {code})")
    print("opened the settings page")
    return 0


def _print_settings_url(url: str, reason: str) -> int:
    """The fallback: say why on stderr, the URL alone on stdout."""
    print(f"flowctl: {reason}; open this address in a browser:", file=sys.stderr)
    print(url)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
